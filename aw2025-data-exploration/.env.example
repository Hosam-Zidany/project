# Copy this file to ".env" and edit. NEVER commit ".env".

# SQL Server instance (examples: localhost | localhost\SQLEXPRESS | 127.0.0.1,1433)
DB_SERVER=localhost
DB_NAME=AdventureWorks2025
DB_DRIVER=ODBC Driver 17 for SQL Server

# yes  -> Windows authentication (no user/password needed)
# no   -> SQL authentication (fill DB_USER and DB_PASSWORD)
DB_TRUSTED=no
DB_USER=sa
DB_PASSWORD=password
